PORT=4000
# --- Local PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sathsangath
DB_USER=postgres
DB_PASSWORD=your-password
# Prisma reads this one (built from the DB_* values above)
DATABASE_URL="postgresql://postgres:your-password@localhost:5432/sathsangath?schema=public"
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
JWT_EXPIRES_IN="7d"
# Comma-separated list of allowed web origins (mobile apps do not need CORS)
CORS_ORIGINS="http://localhost:3100,http://127.0.0.1:3100"
# Shared secret for the Google Form / Apps Script webhook
INTAKE_WEBHOOK_SECRET="change-me-webhook-secret"
# Website login link sent inside credential SMS/emails
WEB_LOGIN_URL="http://localhost:3100/login"
# Seed admin (used only by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@sathsangath.in"
SEED_ADMIN_PASSWORD="Admin@12345"
